# Treadwell Customer Proposal Portal — environment (prod values live in /opt/treadwell-portal/.env)

ENVIRONMENT=production

# Same Postgres the proposal tool uses (one source of truth).
# Prod: the Supabase Postgres connection string. Local dev uses docker-compose.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Public URL of this portal (used in emailed links).
PUBLIC_BASE_URL=https://portal.wetreadwell.com

# Shared secret the admin proposal tool sends as X-Service-Token to POST /api/notify.
SERVICE_TOKEN=

# Customer session / OTP
PORTAL_SESSION_TTL_HOURS=24
PORTAL_OTP_TTL_MINUTES=10
PORTAL_OTP_MAX_ATTEMPTS=5

# Email (Resend). With no key, emails are logged (dev). Sender must be a verified domain.
# EMAIL_FROM is deliberately not a "noreply" address — replies are wanted, and the
# inbound settings below are what makes them land in the right thread.
RESEND_API_KEY=
EMAIL_FROM=Treadwell <proposals@notify.wetreadwell.com>
NOTIFY_EMAILS=kyle@wetreadwell.com,dane@wetreadwell.com,rj@wetreadwell.com,bids@wetreadwell.com
DEPOSIT_NOTIFY_EMAILS=kyle@wetreadwell.com,dane@wetreadwell.com,rj@wetreadwell.com,kyleene@wetreadwell.com,bids@wetreadwell.com

# Inbound email (Resend receiving) → CRM chat thread. Emails get
# Reply-To: <proposal-token>@RESEND_INBOUND_DOMAIN, and a reply webhooks back into
# the thread. Use the SAME domain as EMAIL_FROM so one address sends and receives;
# it needs a Resend receiving domain plus the MX record Resend gives you.
RESEND_INBOUND_DOMAIN=notify.wetreadwell.com
# Retired receiving domains, comma-separated: accepted on the way in, never minted.
# Keeps replies working when a Reply-To already sits in someone's inbox.
RESEND_INBOUND_LEGACY_DOMAINS=
# Svix signing secret from the Resend webhook. Inbound is DISABLED without it.
RESEND_WEBHOOK_SECRET=
# Mail arriving without a proposal token in the address: match the sender to exactly
# one proposal and file it there, otherwise forward to the notification roster.
# Leave false anywhere that shares a Resend account with production.
INBOUND_SENDER_FALLBACK=false

# Google Sign-In for customers (optional). A Google OAuth *Web Client ID* (public).
# Authorized JS origins must include the portal origins; OAuth consent screen must be
# "External" so customers' Google accounts work. Button only shows when this is set.
GOOGLE_CLIENT_ID=

# Dropbox (folder creation on approval). Leave blank to disable gracefully.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_FOLDER=/Proposals

# Never set DEV_SEED=true in prod.
DEV_SEED=false
